# Copy this file to .env for local development.
# In production on Databricks Apps, secrets are injected from
# secret scopes via app.yaml - do NOT put real secret values
# in this file or commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# TMDB API Key - get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here